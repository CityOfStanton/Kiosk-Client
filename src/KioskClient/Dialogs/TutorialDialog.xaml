<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="KioskClient.Dialogs.TutorialDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Welcome to Kiosk Client!"
    KeyUp="ContentDialog_KeyUp">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#267B30" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#3DBF4A" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#3DBF4A" />
    </ContentDialog.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo area -->
        <StackPanel Grid.Column="0" Grid.Row="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="KIOSK" FontSize="32" FontWeight="Bold"
                       Foreground="#267B30" HorizontalAlignment="Center"/>
            <TextBlock Text="CLIENT" FontSize="20" FontWeight="SemiBold"
                       Foreground="#267B30" HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="0" Grid.Column="2"
                   Text="Welcome to Kiosk Client! Would you like to run the tutorial to get yourself familiar with everything?"
                   TextWrapping="Wrap"
                   Style="{ThemeResource SubtitleTextBlockStyle}"/>

        <StackPanel Grid.Row="2" Grid.Column="2">
            <CheckBox x:Name="DoNotShowCheckBox"
                      Content="Do Not Show This Again"
                      HorizontalAlignment="Right"
                      Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Yes"
                        Style="{StaticResource GreenButtonStyle}"
                        Width="75" Margin="10,0"
                        Click="YesButton_Click"/>
                <Button Content="No"
                        Style="{StaticResource GreenButtonStyle}"
                        Width="75" Margin="10,0"
                        Click="CloseButton_Click"/>
                <Button Content="Close"
                        Style="{StaticResource GreenButtonStyle}"
                        Width="75" Margin="10,0"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ContentDialog>
