<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="KioskClient.Dialogs.TutorialDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Welcome to Kiosk Client!"
    PrimaryButtonText="Teach me to create"
    SecondaryButtonText="Teach me to run"
    CloseButtonText="Not now"
    PrimaryButtonStyle="{StaticResource GreenButtonStyle}"
    SecondaryButtonStyle="{StaticResource GreenButtonStyle}"
    DefaultButton="Primary"
    KeyUp="ContentDialog_KeyUp">
    <ScrollViewer MaxHeight="460">
        <StackPanel Spacing="10" MaxWidth="520">
            <TextBlock Text="What does this app do?" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Text="Kiosk Client turns a screen into a full-screen kiosk or digital sign that automatically cycles through images, websites, and videos." />
            <TextBlock Text="What is an Orchestration?" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Text="An orchestration is a playlist of Actions plus a few rules: its name, what happens when it reaches the end (Lifecycle), and the order actions play in (Order). It is saved as a JSON or XML file and can be loaded from a file or a URL." />
            <TextBlock Text="What are Actions?" FontWeight="SemiBold" />
            <StackPanel Spacing="4" Margin="8,0,0,0"><TextBlock TextWrapping="Wrap" Text="&#8226;  Image: shows a picture for a set duration." /><TextBlock TextWrapping="Wrap" Text="&#8226;  Website: displays a web page, optionally auto-scrolling." /><TextBlock TextWrapping="Wrap" Text="&#8226;  Video: plays a video file or stream." /></StackPanel>
            <TextBlock Text="What would you like to learn?" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock TextWrapping="Wrap" Text="Create: build and configure your own orchestration in the Editor. Run: load an existing orchestration and play it. You can reopen this tutorial any time from Tutorial in the Settings menu." />
            <CheckBox x:Name="DoNotShowCheckBox" Content="Do not show this on startup again" ToolTipService.ToolTip="When checked, this welcome dialog no longer appears when the app starts." />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
