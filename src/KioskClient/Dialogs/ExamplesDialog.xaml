<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="KioskClient.Dialogs.ExamplesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Generate Examples"
    KeyUp="ContentDialog_KeyUp">

    <StackPanel Spacing="16">
        <TextBlock TextWrapping="WrapWholeWords"
                   Style="{ThemeResource SubtitleTextBlockStyle}">
            You can generate example Orchestration files in JSON or XML.
            Once generated, customize the file with any text editor.
            Then load the file in the Settings page and start your Orchestration!
        </TextBlock>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Generate Example Orchestration:"
                       VerticalAlignment="Center"
                       Style="{ThemeResource SubtitleTextBlockStyle}"/>
            <Button x:Name="JsonButton" Content="JSON"
                    Click="JsonButton_Click"/>
            <Button x:Name="XmlButton" Content="XML"
                    Click="XmlButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Foreground="#267B30"
                   TextWrapping="Wrap"/>

        <Button Content="Close"
                Style="{StaticResource GreenButtonStyle}"
                Width="200"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Click="CloseButton_Click"/>
    </StackPanel>
</ContentDialog>
