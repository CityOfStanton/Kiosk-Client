<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Colors -->
    <Color x:Key="KioskGreenColor">#267B30</Color>
    <SolidColorBrush x:Key="KioskGreenBrush" Color="{StaticResource KioskGreenColor}" />
    <SolidColorBrush x:Key="KioskGreenHoverBrush" Color="#2D9139" />

    <!-- Green Button Style -->
    <Style x:Key="GreenButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource KioskGreenBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <!-- Green Accent Button Style -->
    <Style x:Key="AccentGreenButtonStyle" TargetType="Button" BasedOn="{StaticResource GreenButtonStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="24,10" />
    </Style>

    <!-- Transparent Settings Overlay Button -->
    <Style x:Key="OverlayButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#80000000" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Network Disconnected Watermark -->
    <Style x:Key="WatermarkTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#80FF4444" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Validation Icons -->
    <x:String x:Key="ValidationPassedIcon">&#xF78C;</x:String>
    <x:String x:Key="ValidationFailedIcon">&#xE711;</x:String>

</ResourceDictionary>
