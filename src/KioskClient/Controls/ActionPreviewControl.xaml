<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KioskClient.Controls.ActionPreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Black">
        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
        <WebView2 x:Name="PreviewWeb" IsHitTestVisible="False" Visibility="Collapsed" />
        <MediaPlayerElement x:Name="PreviewVideo" AreTransportControlsEnabled="False" IsHitTestVisible="False" Visibility="Collapsed" />
        <ProgressRing x:Name="PreviewProgress" IsActive="False" Width="32" Height="32" Foreground="White" />
        <TextBlock x:Name="PreviewMessage"
                   Foreground="White"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="12"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
