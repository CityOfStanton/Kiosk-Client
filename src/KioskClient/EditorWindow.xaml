<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KioskClient.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KioskClient.Controls"
    xmlns:vm="using:KioskClient.ViewModels">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PreviewColumn.Width" Value="0" />
                        <Setter Target="PreviewSplitter.Visibility" Value="Collapsed" />
                        <Setter Target="PreviewRow.Height" Value="Auto" />
                        <Setter Target="PreviewPane.(Grid.Column)" Value="0" />
                        <Setter Target="PreviewPane.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Header: commands + file -->
        <StackPanel Grid.Row="0">
            <CommandBar DefaultLabelPosition="Right" IsOpen="False" HorizontalAlignment="Left">
                <AppBarButton Label="New" Icon="Add" Click="NewButton_Click">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Label="Open" Icon="OpenFile" Click="OpenButton_Click">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Label="Save" Icon="Save" Click="SaveButton_Click">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton Label="Save As" Icon="SaveLocal" Click="SaveAsButton_Click">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="UndoButton" Label="Undo" Icon="Undo" IsEnabled="False" Click="UndoButton_Click">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Z" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="RedoButton" Label="Redo" Icon="Redo" IsEnabled="False" Click="RedoButton_Click">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Y" Modifiers="Control" />
                        <KeyboardAccelerator Key="Z" Modifiers="Control,Shift" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Validate" Icon="Accept" Click="ValidateButton_Click">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar>
            <TextBox x:Name="FilePathBox"
                     IsReadOnly="True"
                     PlaceholderText="Unsaved orchestration (no file loaded)"
                     AutomationProperties.Name="Loaded file path"
                     Margin="12,4,12,8" />
        </StackPanel>

        <!-- Messages -->
        <StackPanel Grid.Row="1">
            <InfoBar x:Name="MigrationBar"
                     IsOpen="False"
                     Severity="Informational"
                     Title="Converted to version 2.0"
                     IsClosable="True" />
            <InfoBar x:Name="ValidationBar"
                     IsOpen="False"
                     IsClosable="True" />
        </StackPanel>

        <!-- Three panes: actions | form | preview -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pane 1: action list -->
            <Grid Grid.Column="0" Padding="12,0,8,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Actions" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <CommandBar Grid.Column="1"
                                DefaultLabelPosition="Collapsed"
                                OverflowButtonVisibility="Collapsed"
                                HorizontalAlignment="Right"
                                IsOpen="False"
                                Background="Transparent">
                        <AppBarButton Label="Add action" Icon="Add">
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Image" Tag="Image" Click="AddAction_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE91B;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Website" Tag="Website" Click="AddAction_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Video" Tag="Video" Click="AddAction_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE714;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton x:Name="MoveUpButton" Label="Move up" Click="MoveUp_Click">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE74A;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="MoveDownButton" Label="Move down" Click="MoveDown_Click">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="RemoveButton" Label="Remove action" Icon="Delete" Click="RemoveAction_Click" />
                    </CommandBar>
                </Grid>

                <ListView x:Name="ActionList"
                          Grid.Row="1"
                          SelectionMode="Single"
                          CanReorderItems="True"
                          CanDragItems="True"
                          AllowDrop="True"
                          DragItemsCompleted="ActionList_DragItemsCompleted"
                          SelectionChanged="ActionList_SelectionChanged"
                          KeyDown="ActionList_KeyDown">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EditorActionItem">
                            <Grid ColumnSpacing="12" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind TypeLabel}" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <controls:ColumnSplitter Grid.Column="1" MinColumnWidth="220" />

            <!-- Pane 2 + 3: form and preview -->
            <Grid Grid.Column="2" Padding="0,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="420" MinWidth="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="PreviewRow" Height="0" />
                </Grid.RowDefinitions>

                <!-- Form -->
                <ScrollViewer Grid.Column="0" Grid.Row="0">
                    <StackPanel Spacing="8" Padding="0,0,12,0">

                        <Expander Header="Orchestration"
                                  IsExpanded="True"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBox x:Name="NameBox" Header="Name" TextChanged="NameBox_TextChanged" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="LifecycleBox" Header="Lifecycle" HorizontalAlignment="Stretch" SelectionChanged="LifecycleBox_SelectionChanged" />
                                    <ComboBox x:Name="OrderBox" Grid.Column="1" Header="Order" HorizontalAlignment="Stretch" SelectionChanged="OrderBox_SelectionChanged" />
                                </Grid>
                                <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                        </Expander>

                        <TextBlock x:Name="NoSelectionText"
                                   Text="Select or add an action to edit it."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="4,12" />

                        <StackPanel x:Name="ActionPanel" Spacing="8" Visibility="Collapsed">

                            <TextBlock x:Name="ActionTypeText" Style="{StaticResource SectionTitleTextStyle}" />

                            <Expander Header="Source"
                                      IsExpanded="True"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <TextBox x:Name="ActionNameBox" Header="Action name" TextChanged="ActionNameBox_TextChanged" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PathBox" Header="Path (URL or full file path)" TextChanged="PathBox_TextChanged" />
                                        <Button x:Name="TestPathButton" Grid.Column="1" VerticalAlignment="Bottom" Click="TestPath_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <SymbolIcon Symbol="Play" />
                                                <TextBlock Text="Test" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="PathStatus" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Display"
                                      IsExpanded="True"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <ComboBox x:Name="StretchBox" Header="Stretch" MinWidth="180" SelectionChanged="StretchBox_SelectionChanged" />
                                    <NumberBox x:Name="DurationBox"
                                               Header="Duration (seconds)"
                                               Minimum="0"
                                               SpinButtonPlacementMode="Inline"
                                               MaxWidth="240"
                                               HorizontalAlignment="Left"
                                               ValueChanged="DurationBox_ValueChanged" />
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="VideoPanel"
                                      Header="Video"
                                      IsExpanded="True"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <ComboBox x:Name="PlayModeBox" Header="Play mode" MinWidth="180" SelectionChanged="PlayModeBox_SelectionChanged" />
                                    <CheckBox x:Name="MuteCheck" Content="Mute audio" Click="MuteCheck_Click" />
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="WebsitePanel"
                                      Header="Scrolling"
                                      IsExpanded="False"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12">
                                    <CheckBox x:Name="AutoScrollCheck" Content="Auto-scroll" Click="AutoScrollCheck_Click" />
                                    <NumberBox x:Name="ScrollSpeedBox" Header="Scroll speed (1 = default, 2 = twice as fast, 0.5 = half speed)" Minimum="0.1" Maximum="10" SmallChange="0.1" LargeChange="0.5" SpinButtonPlacementMode="Inline" MaxWidth="240" HorizontalAlignment="Left" ValueChanged="ScrollSpeedBox_ValueChanged" />
                                    <NumberBox x:Name="ScrollingStartDelayBox" Header="Scrolling start delay (seconds)" Minimum="0" SpinButtonPlacementMode="Inline" MaxWidth="240" HorizontalAlignment="Left" ValueChanged="WebsiteNumber_ValueChanged" />
                                    <NumberBox x:Name="SettingsDisplayTimeBox" Header="Settings display time (seconds)" Minimum="0" SpinButtonPlacementMode="Inline" MaxWidth="240" HorizontalAlignment="Left" ValueChanged="WebsiteNumber_ValueChanged" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <controls:ColumnSplitter x:Name="PreviewSplitter" Grid.Column="1" ResizeNext="True" MinColumnWidth="240" />

                <!-- Preview -->
                <Border x:Name="PreviewPane"
                        Grid.Column="2"
                        Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}"
                        VerticalAlignment="Top"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="Preview" Style="{StaticResource SectionTitleTextStyle}" Margin="0" VerticalAlignment="Center" />
                            <Button x:Name="LoadPreviewButton" HorizontalAlignment="Right" Click="TestPath_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="Load preview" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Height="260">
                            <controls:ActionPreviewControl x:Name="ActionPreview" Height="260" />
                            <Border x:Name="PreviewHintBanner"
                                    Background="{ThemeResource SystemControlBackgroundAltMediumBrush}"
                                    CornerRadius="4"
                                    IsHitTestVisible="False">
                                <TextBlock Text="Click Test or Load preview to load the preview."
                                           Style="{StaticResource SecondaryTextStyle}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="16"
                                           FontSize="14" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryTextStyle}" />
        </Border>
    </Grid>
</Window>
