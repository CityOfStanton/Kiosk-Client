<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KioskClient.Pages.Actions.WebsitePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="Black">

    <Grid>
        <!-- Error state -->
        <StackPanel x:Name="ErrorPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="Red"/>
            <TextBlock Text="Failed to load website"
                       FontSize="18" Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="ErrorDetail"
                       FontSize="14" Foreground="Gray"
                       TextWrapping="Wrap" MaxWidth="600"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- WebView2 -->
        <WebView2 x:Name="WebviewDisplay"
                  Visibility="Collapsed"/>

        <!-- Settings/Exit button overlay -->
        <Button x:Name="SettingsButton"
                Click="SettingsButton_Click"
                Style="{StaticResource OverlayButtonStyle}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,16,0">
            <FontIcon Glyph="&#xE713;" FontSize="20"/>
        </Button>
    </Grid>
</Page>
