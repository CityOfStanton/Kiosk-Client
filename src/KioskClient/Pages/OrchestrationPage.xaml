<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KioskClient.Pages.OrchestrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black"
    KeyDown="Page_KeyDown">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid>
        <!-- Action Content Frame -->
        <Frame x:Name="ActionFrame" />

        <!-- Network Disconnected Watermark -->
        <TextBlock x:Name="NetworkWatermark"
                   Text="&#xE871; Network Disconnected"
                   FontFamily="{ThemeResource SymbolThemeFontFamily}"
                   Style="{StaticResource WatermarkTextStyle}"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Left"
                   Margin="16,0,0,16"
                   Visibility="Collapsed" />
    </Grid>
</Page>
