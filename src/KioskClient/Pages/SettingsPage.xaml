<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KioskClient.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KioskClient.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="Page_KeyDown">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToInvertedVisibilityConverter x:Key="BoolToInvVis" />
        <converters:InvertBooleanConverter x:Key="InvertBool" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:BooleanToSymbolConverter x:Key="BoolToSymbol" />
        <converters:BooleanToColorConverter x:Key="BoolToColor" />
        <converters:AutoRetryActiveToSymbolConverter x:Key="RetrySymbol" />
    </Page.Resources>

    <NavigationView x:Name="NavView"
                    PaneDisplayMode="LeftCompact"
                    IsBackButtonVisible="Collapsed"
                    ItemInvoked="NavView_ItemInvoked">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="NavItem_Run" Content="Run Orchestration" Icon="Play" Tag="Run"
                                IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.RunTooltip, Mode=OneWay}" />
            <NavigationViewItem x:Name="NavItem_Save" Content="Save as Startup" Icon="SaveLocal" Tag="Save" />
            <NavigationViewItem x:Name="NavItem_Reset" Content="Reset Settings" Icon="Clear" Tag="Reset" />
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="NavItem_Examples" Content="Examples" Icon="Download" Tag="Examples" />
            <NavigationViewItem x:Name="NavItem_Tutorial" Content="Tutorial" Tag="Tutorial">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7BE;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavItem_Help" Content="Help" Icon="Help" Tag="Help" />
            <NavigationViewItem x:Name="NavItem_About" Content="About" Tag="About">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <!-- Main Content Area -->
        <ScrollViewer>
            <Pivot x:Name="MainPivot" Margin="12">

                <!-- Orchestration Tab -->
                <PivotItem Header="Orchestration">
                    <StackPanel Spacing="16" Padding="0,12,0,0">

                        <!-- Source Toggle -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Source:" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <RadioButton x:Name="RadioUrl" Content="URL" GroupName="Source"
                                         IsChecked="{x:Bind ViewModel.IsLocalFile, Mode=TwoWay, Converter={StaticResource InvertBool}}" />
                            <RadioButton x:Name="RadioFile" Content="File" GroupName="Source"
                                         IsChecked="{x:Bind ViewModel.IsLocalFile, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- URL Input -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsLocalFile, Mode=OneWay, Converter={StaticResource BoolToInvVis}}"
                                    Spacing="8">
                            <TextBlock Text="Orchestration URL:" FontWeight="SemiBold" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="UrlComboBox"
                                          Grid.Column="0"
                                          IsEditable="True"
                                          Text="{x:Bind ViewModel.UriPath, Mode=TwoWay}"
                                          ItemsSource="{x:Bind ViewModel.UrlHistory}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Enter URL to orchestration file..." />
                                <Button Grid.Column="1"
                                        Content="Load"
                                        Command="{x:Bind ViewModel.LoadFromUriCommand}"
                                        Style="{StaticResource GreenButtonStyle}"
                                        Margin="8,0,0,0" />
                            </Grid>
                            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsUriLoading, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.IsUriLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- File Input -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsLocalFile, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Spacing="8">
                            <TextBlock Text="Orchestration File:" FontWeight="SemiBold" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{x:Bind ViewModel.LocalPath, Mode=TwoWay}"
                                         PlaceholderText="Select an orchestration file..."
                                         IsReadOnly="True" />
                                <Button Grid.Column="1"
                                        Content="Browse..."
                                        Click="BrowseFile_Click"
                                        Style="{StaticResource GreenButtonStyle}"
                                        Margin="8,0,0,0" />
                            </Grid>
                            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsFileLoading, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.IsFileLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Orchestration Summary -->
                        <Border Visibility="{x:Bind ViewModel.Orchestration, Mode=OneWay, Converter={StaticResource NullToVis}}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Orchestration Summary" FontWeight="Bold" FontSize="16" />
                                <Grid ColumnSpacing="12" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryName, Mode=OneWay}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Version:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryVersion, Mode=OneWay}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Source:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummarySource, Mode=OneWay}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Lifecycle:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryLifecycle, Mode=OneWay}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Order:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryOrder, Mode=OneWay}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Actions:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryActionCount, Mode=OneWay}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Runtime:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryRuntime, Mode=OneWay}" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Polling Interval:" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryPollingInterval, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Auto-Retry Section -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <ToggleSwitch Header="Auto-Retry on Return"
                                              IsOn="{x:Bind ViewModel.IsAutoRetryEnabled, Mode=TwoWay}" />
                                <TextBlock Text="When enabled, the orchestration will automatically restart after returning to the home screen."
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </PivotItem>

                <!-- Validation Tab -->
                <PivotItem Header="Validation">
                    <StackPanel Spacing="12" Padding="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="16"
                                    Visibility="{x:Bind ViewModel.OrchestrationValidationResult, Mode=OneWay, Converter={StaticResource NullToVis}}">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Passed: " />
                                <Run x:Name="PassedCount" Foreground="{StaticResource KioskGreenBrush}" />
                            </TextBlock>
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Failed: " />
                                <Run x:Name="FailedCount" Foreground="Red" />
                            </TextBlock>
                        </StackPanel>

                        <TreeView x:Name="ValidationTree"
                                  Visibility="{x:Bind ViewModel.OrchestrationValidationResult, Mode=OneWay, Converter={StaticResource NullToVis}}" />

                        <TextBlock Text="Load an orchestration to see validation results."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontStyle="Italic" />
                    </StackPanel>
                </PivotItem>

                <!-- Log Tab -->
                <PivotItem Header="Log">
                    <Grid Padding="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button Content="Copy All" Click="CopyLog_Click" />
                            <Button Content="Clear" Click="ClearLog_Click" />
                        </StackPanel>

                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.LogEntries}" 
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </PivotItem>

                <!-- Settings Tab -->
                <PivotItem Header="Settings">
                    <StackPanel Spacing="16" Padding="0,12,0,0">

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Auto-Retry" FontWeight="Bold" FontSize="16" />

                                <ToggleSwitch Header="Enable Auto-Retry"
                                              IsOn="{x:Bind ViewModel.IsAutoRetryEnabled, Mode=TwoWay}" />

                                <NumberBox Header="Retry Delay (seconds)"
                                           Value="{x:Bind ViewModel.AutoRetrySeconds, Mode=TwoWay}"
                                           Minimum="5"
                                           Maximum="300"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="5"
                                           LargeChange="15" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="URL History" FontWeight="Bold" FontSize="16" />

                                <TextBlock Text="Previously loaded URLs are saved for quick access."
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" />

                                <ListView ItemsSource="{x:Bind ViewModel.UrlHistory}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </PivotItem>

            </Pivot>
        </ScrollViewer>
    </NavigationView>
</Page>
