<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KioskClient.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:KioskClient.Converters"
    xmlns:vm="using:KioskClient.ViewModels"
    xmlns:local="using:KioskClient.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="Page_KeyDown">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToInvertedVisibilityConverter x:Key="BoolToInvVis" />
        <converters:InvertBooleanConverter x:Key="InvertBool" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToBoolConverter x:Key="NullToBool" />
        <converters:BooleanToSymbolConverter x:Key="BoolToSymbol" />
        <converters:BooleanToColorConverter x:Key="BoolToColor" />
        <converters:AutoRetryActiveToSymbolConverter x:Key="RetrySymbol" />
    </Page.Resources>

    <NavigationView x:Name="NavView"
                    PaneDisplayMode="Left"
                    OpenPaneLength="220"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    ItemInvoked="NavView_ItemInvoked">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="NavItem_Orchestration" Content="Orchestration" Tag="Orchestration">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavItem_Settings" Content="Settings" Icon="Setting" Tag="Settings" />
            <NavigationViewItem x:Name="NavItem_Log" Content="Log" Icon="Message" Tag="Log" />
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="NavItem_Examples" Content="Examples" Icon="Download" Tag="Examples" SelectsOnInvoked="False" />
            <NavigationViewItem x:Name="NavItem_Tutorial" Content="Tutorial" Tag="Tutorial" SelectsOnInvoked="False">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7BE;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavItem_Help" Content="Help" Icon="Help" Tag="Help" SelectsOnInvoked="False" />
            <NavigationViewItem x:Name="NavItem_About" Content="About" Tag="About" SelectsOnInvoked="False">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <!-- Main Content Area -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <!-- Startup Retry Banner -->
                <InfoBar x:Name="StartupRetryBanner"
                         IsOpen="False"
                         Severity="Warning"
                         Title="Auto-Retry Active"
                         IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="StopStartupRetryButton"
                                Content="Stop"
                                Click="StopStartupRetry_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Deprecated fields banner -->
                <InfoBar x:Name="DeprecatedPollingIntervalBanner"
                         IsOpen="{x:Bind ViewModel.HasDeprecatedFields, Mode=OneWay}"
                         Severity="Informational"
                         Title="Deprecated Fields Detected"
                         Message="{x:Bind ViewModel.DeprecatedFieldsMessage, Mode=OneWay}"
                         IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button Content="Open in Editor" Click="OpenInEditor_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <Grid Grid.Row="1">

                <!-- Orchestration Section -->
                <ScrollViewer x:Name="OrchestrationSection">
                    <StackPanel HorizontalAlignment="Stretch"
                                Padding="{StaticResource PagePadding}"
                                Spacing="{StaticResource SectionSpacing}">

                        <TextBlock Text="Orchestration" Style="{StaticResource PageTitleTextStyle}" />

                        <!-- Run card: choose source, load, run -->
                        <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">

                        <!-- Source Toggle -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Source" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <RadioButton x:Name="RadioUrl" Content="URL" GroupName="Source" MinWidth="0"
                                         IsChecked="{x:Bind ViewModel.IsLocalFile, Mode=TwoWay, Converter={StaticResource InvertBool}}" />
                            <RadioButton x:Name="RadioFile" Content="File" GroupName="Source" MinWidth="0"
                                         IsChecked="{x:Bind ViewModel.IsLocalFile, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- URL Input -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsLocalFile, Mode=OneWay, Converter={StaticResource BoolToInvVis}}"
                                    Spacing="8">
                            <TextBlock Text="Orchestration URL:" FontWeight="SemiBold" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <AutoSuggestBox x:Name="UrlAutoSuggestBox"
                                                    Loaded="UrlAutoSuggestBox_Loaded"
                                                    Text="{x:Bind ViewModel.UriPath, Mode=TwoWay}"
                                                    ItemsSource="{x:Bind ViewModel.UrlHistory, Mode=OneWay}"
                                                    PlaceholderText="Enter URL to orchestration file..."
                                                    QuerySubmitted="UrlAutoSuggestBox_QuerySubmitted"
                                                    SuggestionChosen="UrlAutoSuggestBox_SuggestionChosen"
                                                    HorizontalAlignment="Stretch" />
                                    <Button x:Name="UrlHistoryDropDownButton"
                                            Click="UrlHistoryDropDown_Click"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,4,0"
                                            Padding="8,4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ToolTipService.ToolTip="Show URL history"
                                            AutomationProperties.Name="Show URL history">
                                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                    </Button>
                                </Grid>
                                <Button Grid.Column="1"
                                        Command="{x:Bind ViewModel.LoadFromUriCommand}"
                                        Style="{StaticResource GreenButtonStyle}"
                                        Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Download" />
                                        <TextBlock Text="Load" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsUriLoading, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.IsUriLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- File Input -->
                        <StackPanel Visibility="{x:Bind ViewModel.IsLocalFile, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Spacing="8">
                            <TextBlock Text="Orchestration File:" FontWeight="SemiBold" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{x:Bind ViewModel.LocalPath, Mode=TwoWay}"
                                         PlaceholderText="Select an orchestration file..."
                                         IsReadOnly="True" />
                                <Button Grid.Column="1"
                                        Content="Browse..."
                                        Click="BrowseFile_Click"
                                        Style="{StaticResource GreenButtonStyle}"
                                        Margin="8,0,0,0" />
                            </Grid>
                            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsFileLoading, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.IsFileLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <!-- Load Error -->
                        <InfoBar x:Name="LoadErrorBar"
                                 IsOpen="False"
                                 Severity="Error"
                                 Title="Failed to Load Orchestration"
                                 IsClosable="False" />

                        <!-- Run actions -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RunButton"
                                    Click="RunButton_Click"
                                    Style="{StaticResource AccentGreenButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.RunTooltip, Mode=OneWay}"
                                    AutomationProperties.Name="Run orchestration">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Play" />
                                    <TextBlock Text="Run orchestration" />
                                    <TextBlock Text="F5" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                                </Button>
                                <Button Click="OpenInEditor_Click" AutomationProperties.Name="Open orchestration editor">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Edit" />
                                    <TextBlock Text="Open in editor" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        </StackPanel>
                        </Border>

                        <!-- Orchestration Summary -->
                        <Border Visibility="{x:Bind ViewModel.Orchestration, Mode=OneWay, Converter={StaticResource NullToVis}}"
                                Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Summary" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                                <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" ColumnSpacing="12" RowSpacing="6" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryName, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryVersion, Mode=OneWay}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Source" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummarySource, Mode=OneWay}" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Lifecycle" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryLifecycle, Mode=OneWay}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Order" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryOrder, Mode=OneWay}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Actions" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryActionCount, Mode=OneWay}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Runtime" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.OrchestrationSummaryRuntime, Mode=OneWay}" />
                                </Grid>

                                <StackPanel Grid.Column="1" Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PreviewCaption"
                                               Grid.Column="0"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <StackPanel x:Name="PreviewNavPanel"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                Visibility="Collapsed">
                                        <Button x:Name="PreviewPrevButton"
                                                Click="PreviewPrev_Click"
                                                Padding="6"
                                                ToolTipService.ToolTip="Previous action"
                                                AutomationProperties.Name="Previous action">
                                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                        </Button>
                                        <TextBlock x:Name="PreviewPositionText"
                                                   VerticalAlignment="Center"
                                                   MinWidth="40"
                                                   TextAlignment="Center" />
                                        <Button x:Name="PreviewNextButton"
                                                Click="PreviewNext_Click"
                                                Padding="6"
                                                ToolTipService.ToolTip="Next action"
                                                AutomationProperties.Name="Next action">
                                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Border Background="Black"
                                        CornerRadius="4"
                                        Height="240"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed" />
                                        <WebView2 x:Name="PreviewWeb" IsHitTestVisible="False" Visibility="Collapsed" />
                                        <MediaPlayerElement x:Name="PreviewVideo" AreTransportControlsEnabled="False" IsHitTestVisible="False" Visibility="Collapsed" />
                                        <ProgressRing x:Name="PreviewProgress" IsActive="False" Width="32" Height="32" Foreground="White" />
                                        <TextBlock x:Name="PreviewMessage"
                                                   Foreground="Gray"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="12"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Validation Results (collapsible) -->
                        <Expander x:Name="ValidationExpander"
                                  Header="Validation Results"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Visibility="{x:Bind ViewModel.OrchestrationValidationResult, Mode=OneWay, Converter={StaticResource NullToVis}}">
                            <StackPanel Spacing="12" Padding="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="24">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon x:Name="PassedIcon" Glyph="&#xE73E;" FontSize="22" />
                                        <TextBlock x:Name="PassedCount" FontWeight="SemiBold" FontSize="22" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon x:Name="FailedIcon" Glyph="&#xE711;" FontSize="22" />
                                        <TextBlock x:Name="FailedCount" FontWeight="SemiBold" FontSize="22" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <TreeView x:Name="ValidationTree">
                                    <TreeView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="{Binding Content.Glyph}"
                                                          Foreground="{Binding Content.IconForeground}"
                                                          FontSize="14"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Content.Label}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>

                <!-- Log Section -->
                <Grid x:Name="LogSection"
                      Visibility="Collapsed"
                      HorizontalAlignment="Stretch"
                      Padding="{StaticResource PagePadding}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" HorizontalAlignment="Left">
                            <Button Click="CopyLog_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="Copy To Clipboard" />
                                </StackPanel>
                            </Button>
                            <Button Click="SaveLog_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="Save as Text File" />
                                </StackPanel>
                            </Button>
                            <Button Click="ClearLog_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="Clear" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ListView Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.LogEntries}" 
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                <!-- Settings Section -->
                <ScrollViewer x:Name="SettingsSection" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch"
                                Padding="{StaticResource PagePadding}"
                                Spacing="{StaticResource SectionSpacing}">

                        <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Auto-Retry" FontWeight="Bold" FontSize="16" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Enable Auto-Retry" />
                                    <TextBlock Text="When enabled, the orchestration will automatically restart after returning to the home screen."
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12" />
                                    <ToggleSwitch AutomationProperties.Name="Enable Auto-Retry"
                                                  IsOn="{x:Bind ViewModel.IsAutoRetryEnabled, Mode=TwoWay}" />
                                </StackPanel>

                                <NumberBox Header="Retry Delay (seconds)"
                                           Value="{x:Bind ViewModel.AutoRetrySeconds, Mode=TwoWay}"
                                           Minimum="5"
                                           Maximum="300"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="5"
                                           LargeChange="15" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Security" FontWeight="Bold" FontSize="16" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Block HTTP addresses" />
                                    <TextBlock Text="When enabled (recommended), orchestrations and content must use HTTPS. Turn off to allow unencrypted http:// addresses."
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12" />
                                    <ToggleSwitch AutomationProperties.Name="Block HTTP addresses"
                                                  IsOn="{x:Bind ViewModel.BlockHttp, Mode=TwoWay}" />
                                </StackPanel>

                                <NumberBox Header="Maximum content size (MB)"
                                           Value="{x:Bind ViewModel.MaxContentMegabytes, Mode=TwoWay}"
                                           Minimum="1"
                                           Maximum="1024"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="10"
                                           LargeChange="50" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Countdown Overlay" FontWeight="Bold" FontSize="16" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Show countdown in bottom-left corner" />
                                    <ToggleSwitch AutomationProperties.Name="Show countdown in bottom-left corner"
                                                  IsOn="{x:Bind ViewModel.ShowCountdown, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Automatically contrast with background" />
                                    <ToggleSwitch AutomationProperties.Name="Automatically contrast with background"
                                                  IsEnabled="{x:Bind ViewModel.ShowCountdown, Mode=OneWay}"
                                                  IsOn="{x:Bind ViewModel.CountdownAutoContrast, Mode=TwoWay}" />
                                </StackPanel>

                                <DropDownButton Content="Font Color"
                                                IsEnabled="{x:Bind local:SettingsPage.IsManualColor(ViewModel.ShowCountdown, ViewModel.CountdownAutoContrast), Mode=OneWay}">
                                    <DropDownButton.Flyout>
                                        <Flyout>
                                            <ColorPicker Color="{x:Bind ViewModel.CountdownColor, Mode=TwoWay}"
                                                         IsAlphaEnabled="False" />
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>

                                <NumberBox Header="Opacity (%)"
                                           Value="{x:Bind ViewModel.CountdownOpacityPercent, Mode=TwoWay}"
                                           IsEnabled="{x:Bind ViewModel.ShowCountdown, Mode=OneWay}"
                                           Minimum="0"
                                           Maximum="100"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="5"
                                           LargeChange="25" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Settings Button Overlay" FontWeight="Bold" FontSize="16" />

                                <NumberBox Header="Opacity (%)"
                                           Value="{x:Bind ViewModel.SettingsButtonOpacityPercent, Mode=TwoWay}"
                                           Minimum="0"
                                           Maximum="100"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="5"
                                           LargeChange="25" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Network Disconnected Indicator" FontWeight="Bold" FontSize="16" />


                                <StackPanel Spacing="4">
                                    <TextBlock Text="Show indicator in bottom-left corner when the connection drops" />
                                    <ToggleSwitch AutomationProperties.Name="Show indicator in bottom-left corner when the connection drops"
                                                  IsOn="{x:Bind ViewModel.ShowNetworkWatermark, Mode=TwoWay}" />
                                </StackPanel>

                                <DropDownButton Content="Background Color"
                                                IsEnabled="{x:Bind ViewModel.ShowNetworkWatermark, Mode=OneWay}">
                                    <DropDownButton.Flyout>
                                        <Flyout>
                                            <ColorPicker Color="{x:Bind ViewModel.NetworkWatermarkBackground, Mode=TwoWay}"
                                                         IsAlphaEnabled="False" />
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>

                                <DropDownButton Content="Font Color"
                                                IsEnabled="{x:Bind ViewModel.ShowNetworkWatermark, Mode=OneWay}">
                                    <DropDownButton.Flyout>
                                        <Flyout>
                                            <ColorPicker Color="{x:Bind ViewModel.NetworkWatermarkForeground, Mode=TwoWay}"
                                                         IsAlphaEnabled="False" />
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="URL History" FontWeight="Bold" FontSize="16" />

                                <TextBlock Text="Previously loaded URLs are saved for quick access."
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" />

                                <NumberBox Header="Maximum entries to keep"
                                           Value="{x:Bind ViewModel.MaxUrlHistory, Mode=TwoWay}"
                                           Minimum="1"
                                           Maximum="50"
                                           SpinButtonPlacementMode="Inline"
                                           SmallChange="1"
                                           LargeChange="5" />

                                <ListView ItemsSource="{x:Bind ViewModel.UrlHistory}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1"
                                                        Tag="{x:Bind}"
                                                        Click="DeleteHistoryEntry_Click"
                                                        Padding="6"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="Delete entry"
                                                        AutomationProperties.Name="Delete entry">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Reset settings" FontWeight="SemiBold" />
                                    <TextBlock Text="Restore all settings to their defaults. This cannot be undone."
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="ResetButton_Click" AutomationProperties.Name="Reset settings">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Clear" />
                                        <TextBlock Text="Reset" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </NavigationView>
</Page>


