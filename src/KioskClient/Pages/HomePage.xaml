<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KioskClient.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF267B30"
    KeyDown="Page_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <!-- Logo Area -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Kiosk Client Logo Text -->
            <TextBlock Text="KIOSK" 
                       FontSize="72" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"
                       CharacterSpacing="200" />
            <TextBlock Text="CLIENT" 
                       FontSize="36" 
                       FontWeight="Light" 
                       Foreground="White"
                       HorizontalAlignment="Center"
                       CharacterSpacing="800"
                       Margin="0,-10,0,0" />
            <Rectangle Height="3" Fill="White" Width="300" Margin="0,10,0,0" />
        </StackPanel>

        <!-- Status Text -->
        <TextBlock x:Name="StatusText" 
                   Grid.Row="1" 
                   Text="Loading..."
                   Foreground="White"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10" />

        <!-- Progress Ring -->
        <ProgressRing x:Name="LoadingRing" 
                      Grid.Row="2" 
                      IsActive="True"
                      Foreground="White"
                      Width="40" Height="40" />

        <!-- Auto-Retry Countdown -->
        <StackPanel x:Name="RetryPanel" 
                    Grid.Row="2" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="RetryCountdownText" 
                       Foreground="White"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <Button x:Name="StopRetryButton"
                    Content="Stop"
                    Click="StopRetryButton_Click"
                    Style="{StaticResource GreenButtonStyle}"
                    Background="#80000000"
                    Padding="12,6" />
        </StackPanel>

        <!-- Settings Button -->
        <Button x:Name="SettingsButton" 
                Grid.Row="4" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="SettingsButton_Click"
                Background="Transparent"
                BorderBrush="White"
                BorderThickness="1"
                Padding="16,8">
            <StackPanel Orientation="Horizontal">
                <SymbolIcon Symbol="Setting" Foreground="White" />
                <TextBlock Text="Settings" Foreground="White" Margin="8,0,0,0" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
